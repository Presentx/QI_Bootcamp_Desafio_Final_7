# ─────────────────────────────────────────────────────────────
# Exemplo de configuração — Motor Antifraude Pix
#
# VOCÊ NÃO PRECISA DISTO PRA COMEÇAR. O "docker compose up" sobe
# com todos os valores abaixo já preenchidos.
#
# Para trocar alguma coisa (uma porta ocupada, o token):
#   cp .env.example .env
# e edite o .env. Ele nunca vai pro Git; este arquivo, sim — por isso
# ele só tem valor de mentirinha.
# ─────────────────────────────────────────────────────────────

# "local" ou "test": log em DEBUG e relógio de teste ligado (o cabeçalho
# X-Test-Clock fixa o "agora" da requisição — é como a suíte monta
# históricos de meses pela API). "production": INFO e relógio real
# sempre, cabeçalho ignorado.
APP_ENV=local

SERVICE_NAME=antifraude-pix-api

# Usada pelos testes (DbUtils) e por quem roda a API fora do Docker.
# Dentro do compose, o banco é sempre db:5432.
DATABASE_URL=postgresql+psycopg2://bootcamp:bootcamp@localhost:5432/bootcamp

# Quem chama manda o header:  INTERNAL-TOKEN: default_token
INTERNAL_TOKEN=default_token

# A rota de confirmação de 2FA (E1). Com "false", ela não existe e todo
# 2FA fica pendente (PE) para sempre.
TWO_FACTOR_ROUTE_ENABLED=true

# Quanto esperar por uma trava antes de responder 503 QIT001006.
LOCK_TIMEOUT=2s

# Onde os testes procuram a API, quando rodados fora do Docker.
# No Windows, prefira 127.0.0.1 (0.0.0.0 não conecta lá).
SERVER_LOCALHOST=0.0.0.0

# Portas — tire o "#" e troque o número se alguma estiver ocupada.
#API_PORT=3001
#DB_PORT=5433
